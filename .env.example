# ============================================================================
# TOPRunAssistant - Environment Configuration (.env.example)
# Copy file này thành .env ở thư mục gốc, apps/api/.env và apps/web/.env.local
# ============================================================================

# --- 1. DATABASE & REDIS (Docker Local - Port 5433 & 6380 tránh trùng container khác) ---
DATABASE_URL="postgresql://toprun:toprun_secret_2026@localhost:5433/toprun_db?schema=public"
REDIS_HOST="localhost"
REDIS_PORT=6380
REDIS_PASSWORD=""

# --- 2. BACKEND API & JWT AUTH ---
PORT=4000
NODE_ENV="development"
JWT_SECRET="toprun_super_secret_jwt_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="https://toprunassistant.io.vn"
API_BASE_URL="https://api.toprunassistant.io.vn"

# --- 3. STRAVA API v3 & WEBHOOK CONFIGURATION ---
# Đăng ký tại: https://www.strava.com/settings/api
STRAVA_CLIENT_ID="292007"
STRAVA_CLIENT_SECRET="54eb7308f454c98fb5e452edb41f1108afb66b10"
STRAVA_REDIRECT_URI="https://api.toprunassistant.io.vn/api/v1/strava/callback"
STRAVA_WEBHOOK_VERIFY_TOKEN="TOPRUN_STRAVA_VERIFY_TOKEN_2026"

# --- 4. OBJECT STORAGE (MinIO / AWS S3 / Cloudflare R2) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_BUCKET_NAME="toprun-assets"

# --- 5. NEXT.JS WEB APP ---
NEXT_PUBLIC_API_URL="https://api.toprunassistant.io.vn/api/v1"
NEXT_PUBLIC_APP_NAME="TOPRunAssistant"

# --- 6. EXPO MOBILE APP ---
EXPO_PUBLIC_API_URL="https://api.toprunassistant.io.vn/api/v1"

# --- 7. SMTP EMAIL SERVICE (Gmail: toprunassistant@gmail.com) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="toprunassistant@gmail.com"
SMTP_PASS="ocyh hckx fwrn mdak"
SMTP_FROM='"TOPRun Assistant" <toprunassistant@gmail.com>'


