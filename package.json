{
  "name": "top-run-assistant",
  "version": "26.11.0",
  "private": true,
  "description": "TOPRunAssistant - Multi-platform Running Management, Tracklog, Challenge & Virtual Race Platform (Android, iOS, Web) with Strava API Sync",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "npm run dev --workspace=@toprun/api",
    "dev:web": "npm run dev --workspace=@toprun/web",
    "dev:mobile": "npm run start --workspace=@toprun/mobile",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "npm run db:generate --workspace=@toprun/database",
    "db:push": "npm run db:push --workspace=@toprun/database",
    "db:seed": "npm run db:seed --workspace=@toprun/database",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml build",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:stop": "docker compose stop",
    "docker:start": "docker compose start",
    "docker:logs": "docker compose logs -f",
    "prod:build": "docker compose -f docker-compose.prod.yml build web api",
    "prod:start": "docker compose -f docker-compose.prod.yml up -d",
    "prod:stop": "docker compose -f docker-compose.prod.yml stop",
    "prod:reload": "docker compose -f docker-compose.prod.yml build web && docker compose -f docker-compose.prod.yml up -d --no-deps web",
    "prod:restart": "docker compose -f docker-compose.prod.yml build web api && docker compose -f docker-compose.prod.yml up -d --remove-orphans && docker compose -f docker-compose.prod.yml exec -T api npx prisma db push --schema=packages/database/prisma/schema.prisma && docker image prune -f",
    "prod:status": "docker compose -f docker-compose.prod.yml ps",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "release": "tsx scripts/release.ts",
    "commit": "powershell -ExecutionPolicy Bypass -File ./scripts/ai-commit.ps1"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
