# --- 1. CƠ SỞ DỮ LIỆU POSTGRESQL & CACHE REDIS (DOCKER INTERNAL NETWORK) ---
POSTGRES_USER="toprun"
POSTGRES_PASSWORD="toprun_secure_prod_2026"
POSTGRES_DB="toprun_db"
DATABASE_URL="postgresql://toprun:toprun_secure_prod_2026@postgres:5432/toprun_db?schema=public"

REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""

# --- 2. BACKEND API & JWT AUTH ---
PORT=4000
NODE_ENV="production"
DATA_DIR="/app/data"
JWT_SECRET="toprun_prod_jwt_super_secret_production_key_2026"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="https://toprunassistant.io.vn"
API_BASE_URL="https://api.toprunassistant.io.vn"

# --- 3. STRAVA API v3 OAUTH2 & WEBHOOK SUBSCRIPTION ---
STRAVA_CLIENT_ID="292007"
STRAVA_CLIENT_SECRET="54eb7308f454c98fb5e452edb41f1108afb66b10"
